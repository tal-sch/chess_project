[configuration]
entry_symbol = "chess_library_init"
compatibility_minimum = "4.2"

[libraries]
windows.debug.x86_64 = "res://bin/chess_engine.dll"
windows.release.x86_64 = "res://bin/chess_engine.dll"
linux.debug.x86_64 = "res://bin/libchess_engine.so"
linux.release.x86_64 = "res://bin/libchess_engine.so"
macos.debug = "res://bin/libchess_engine.dylib"
macos.release = "res://bin/libchess_engine.dylib"
